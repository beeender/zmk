#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

     default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <7>;
        map = <
RC(0, 0)          RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5) RC(0, 7) RC(0, 8) RC(0, 9) RC(0, 10) RC(0, 11) RC(0, 12) RC(0, 13) RC(0, 14) RC(0, 15) RC(1, 0)  RC(1, 5)
RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 6) RC(2, 7) RC(2, 8) RC(2, 9)  RC(2, 10) RC(2, 11) RC(2, 12) RC(2, 14) RC(2, 15) RC(1, 15) RC(1, 6) RC(1, 9)  RC(1, 14) RC(6, 8) RC(3, 1)
RC(3, 0) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5) RC(3, 6) RC(3, 7) RC(3, 8) RC(3, 9) RC(3, 10) RC(3, 11) RC(3, 12) RC(3, 13) RC(3, 14) RC(3, 15) RC(1, 2)  RC(1, 7) RC(1, 10) RC(1, 1)  RC(6, 2) RC(0, 1)
RC(5, 0) RC(4, 2) RC(4, 3) RC(4, 4) RC(4, 5) RC(4, 6) RC(4, 7) RC(4, 8) RC(4, 9) RC(4, 10) RC(4, 11) RC(4, 12)           RC(4, 13)                              RC(1, 11) RC(4, 15) RC(6, 4)
RC(5, 1) RC(5, 2) RC(5, 3) RC(5, 4) RC(5, 5) RC(5, 6) RC(5, 7) RC(5, 8) RC(5, 9) RC(5, 10) RC(5, 11)                     RC(5, 13)           RC(1, 3)           RC(1, 12) RC(5, 14) RC(6, 9) RC(4, 1)
RC(6, 0) RC(6, 1) RC(6, 3)                            RC(6, 6)                             RC(6, 10) RC(6, 11) RC(6, 13) RC(6, 14) RC(6, 15) RC(1, 4)  RC(1, 8) RC(1, 13)           RC(6, 5)

        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        debounce-press-ms = <0>;
        debounce-release-ms = <2>;

        diode-direction = "col2row";
        row-gpios
            = <&gpio1 11  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 10  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 3   (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 28  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 24  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 2   (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 29  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    // TODO: per-key RGB node(s)?
};
